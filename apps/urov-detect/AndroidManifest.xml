<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="com.example.urovdetect">
    <uses-sdk android:minSdkVersion="31" android:targetSdkVersion="35"/>
    <application android:label="UROV detection lab" android:extractNativeLibs="true" android:allowBackup="false">
        <activity android:name=".MainActivity" android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <activity android:name=".ObserverActivity" android:exported="true" android:process=":observer"/>
    </application>
</manifest>
